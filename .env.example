# Copy to .env.local and fill in. .env.local is git-ignored — never commit it.

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://rameshwartiwari.vercel.app

# ---------------------------------------------------------------------------
# Contact form — Gmail SMTP via Nodemailer
#
# SMTP_PASSWORD must be a Google App Password, NOT your account password.
# Create one at https://myaccount.google.com/apppasswords
# (requires 2-Step Verification to be enabled on the account).
# ---------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASSWORD=xxxx xxxx xxxx xxxx

# Where enquiries are delivered. Defaults to SMTP_USER if unset.
CONTACT_TO=you@gmail.com

# ---------------------------------------------------------------------------
# Keystatic admin (production only)
#
# Local dev writes to /content directly and needs none of these.
# For editing from the deployed site, create a GitHub App:
#   https://keystatic.com/docs/github-mode
# ---------------------------------------------------------------------------
NEXT_PUBLIC_GITHUB_OWNER=your-github-username
NEXT_PUBLIC_GITHUB_REPO=portfolio
NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
